{
  "name": "missionguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "contracts:compile": "node scripts/compile.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "tsx --test tests/*.test.ts",
    "demo:local": "node scripts/demo-local.mjs",
    "demo:procurement": "tsx scripts/demo-procurement.ts",
    "demo:fuji": "tsx scripts/demo-fuji.mjs",
    "test:fuji-run": "tsx scripts/test-fuji-run.mjs",
    "submission:check": "node scripts/submission-check.mjs",
    "verify:fuji": "tsx scripts/verify-fuji.mjs",
    "model:configure": "node scripts/configure-model.mjs",
    "model:verify": "tsx scripts/verify-model.ts",
    "deploy:fuji": "node scripts/deploy-fuji.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@openzeppelin/contracts": "5.4.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "^2.56.8",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@nomicfoundation/hardhat-ethers": "^4.1.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "ethers": "^6.17.0",
    "hardhat": "^3.17.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "solc": "0.8.30",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module",
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
